# ==============================================================================
# AI-DRIVEN FACEBOOK & TELEGRAM AUTOMATION CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file as '.env' and fill in your actual API keys and tokens.

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI CONFIGURATION
# ------------------------------------------------------------------------------
# Google Gemini API Key for Asta Plays (Get from: https://aistudio.google.com/app/apikey)
OPENAI_API_KEY_ASTA_PLAYS=your_gemini_api_key_asta_plays_here

# Google Gemini API Key for Nano Facts (Get from: https://aistudio.google.com/app/apikey)
OPENAI_API_KEY_NANO_FACTS=your_gemini_api_key_nano_facts_here

# ------------------------------------------------------------------------------
# 2. FACEBOOK PAGE CONFIGURATION (ASTA PLAYS)
# ------------------------------------------------------------------------------
# Numeric Facebook Page ID for Asta Plays
FB_PAGE_ID_ASTA_PLAYS=your_facebook_page_id_asta_plays

# Permanent Page Access Token for Asta Plays (Permissions: pages_manage_posts, pages_read_engagement)
FB_PAGE_ACCESS_TOKEN_ASTA_PLAYS=your_facebook_page_access_token_asta_plays

# ------------------------------------------------------------------------------
# 3. FACEBOOK PAGE CONFIGURATION (NANO FACTS)
# ------------------------------------------------------------------------------
# Numeric Facebook Page ID for Nano Facts
FB_PAGE_ID_NANO_FACTS=your_facebook_page_id_nano_facts

# Permanent Page Access Token for Nano Facts (Permissions: pages_manage_posts, pages_read_engagement, publish_video)
FB_PAGE_ACCESS_TOKEN_NANO_FACTS=your_facebook_page_access_token_nano_facts

# ------------------------------------------------------------------------------
# 4. TELEGRAM REELS AUTOMATION (NanoFactsPublisherBot)
# ------------------------------------------------------------------------------
# HTTP API Bot Token from @BotFather for your Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Channel 1 ID: Telegram Queue Channel where videos are uploaded ("FB Reels to Post")
TELEGRAM_CHANNEL_QUEUE_ID=-100xxxxxxxxxx

# Channel 2 ID: Telegram Archive Channel where posted videos are moved ("Posted FB Reels Archive")
TELEGRAM_CHANNEL_ARCHIVE_ID=-100yyyyyyyyyy

# ------------------------------------------------------------------------------
# 5. SERVER & FACEBOOK WEBHOOK CONFIGURATION
# ------------------------------------------------------------------------------
# Port for the Webhook HTTP Server (Default: 3000)
PORT=3000

# Secret Verification Token for Facebook Webhook setup (Must match in Meta App Dashboard)
FB_VERIFY_TOKEN=my_facebook_webhook_secret_token

