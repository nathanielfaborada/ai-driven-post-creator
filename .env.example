# ==============================================================================
# AI-DRIVEN FACEBOOK, YOUTUBE & TIKTOK AUTOMATION CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file as '.env' and fill in your actual API keys and tokens.

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI CONFIGURATION (MULTI-KEY LOAD BALANCING POOL)
# ------------------------------------------------------------------------------
GEMINI_PROJECT_1="your_gemini_api_key_1_here"
GEMINI_PROJECT_2="your_gemini_api_key_2_here"
GEMINI_PROJECT_3="your_gemini_api_key_3_here"
GEMINI_PROJECT_4="your_gemini_api_key_4_here"
GEMINI_PROJECT_5="your_gemini_api_key_5_here"
GEMINI_PROJECT_6="your_gemini_api_key_6_here"
GEMINI_PROJECT_7="your_gemini_api_key_7_here"
GEMINI_PROJECT_8="your_gemini_api_key_8_here"
GEMINI_PROJECT_9="your_gemini_api_key_9_here"
GEMINI_PROJECT_10="your_gemini_api_key_10_here"

# ------------------------------------------------------------------------------
# 2. FACEBOOK PAGE CONFIGURATION (ASTA PLAYS)
# ------------------------------------------------------------------------------
FB_PAGE_ID_ASTA_PLAYS="your_facebook_page_id_asta_plays"
FB_PAGE_ACCESS_TOKEN_ASTA_PLAYS="your_facebook_page_access_token_asta_plays"

# ------------------------------------------------------------------------------
# 3. FACEBOOK PAGE CONFIGURATION (NANO FACTS)
# ------------------------------------------------------------------------------
FB_PAGE_ID_NANO_FACTS="your_facebook_page_id_nano_facts"
FB_PAGE_ACCESS_TOKEN_NANO_FACTS="your_facebook_page_access_token_nano_facts"

# ------------------------------------------------------------------------------
# 4. YOUTUBE SHORTS AUTOMATION (NANO FACTS CHANNEL)
# ------------------------------------------------------------------------------
YOUTUBE_CLIENT_ID="your_google_cloud_oauth_client_id"
YOUTUBE_CLIENT_SECRET="your_google_cloud_oauth_client_secret"
YOUTUBE_REFRESH_TOKEN="your_google_oauth_refresh_token"

# ------------------------------------------------------------------------------
# 5. TIKTOK AUTOMATION (NANO FACTS CHANNEL)
# ------------------------------------------------------------------------------
TIKTOK_CLIENT_KEY="your_tiktok_client_key"
TIKTOK_CLIENT_SECRET="your_tiktok_client_secret"
TIKTOK_REFRESH_TOKEN="your_tiktok_refresh_token"
TIKTOK_OPEN_ID="your_tiktok_open_id"

# ------------------------------------------------------------------------------
# 6. TELEGRAM REELS AUTOMATION (NanoFactsPublisherBot)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Channel 1: Queue Channel where you upload reels to be published ("FB Reels to Post")
TELEGRAM_CHANNEL_QUEUE_ID="-100xxxxxxxxxx"

# 10-Channel Category Archive Channels
TG_CHANNEL_BIOLOGY_ID="-100xxxxxxxxxx"       # 🧬 Human Biology & Anatomy
TG_CHANNEL_CHEMISTRY_ID="-100xxxxxxxxxx"     # ⚛️ Chemistry & Periodic Table
TG_CHANNEL_ASTRONOMY_ID="-100xxxxxxxxxx"     # 🌌 Astronomy & Deep Space
TG_CHANNEL_PHYSICS_ID="-100xxxxxxxxxx"       # ⚡ Quantum & Modern Physics
TG_CHANNEL_ROBOTICS_ID="-100xxxxxxxxxx"      # 🤖 AI, Robotics & Future Technology
TG_CHANNEL_OCEAN_ID="-100xxxxxxxxxx"         # 🌊 Deep Sea & Ocean Mysteries
TG_CHANNEL_EARTH_ID="-100xxxxxxxxxx"         # 🌋 Earth Sciences & Extreme Nature
TG_CHANNEL_MATERIALS_ID="-100xxxxxxxxxx"     # 🔬 Materials Science & Nanotechnology
TG_CHANNEL_PALEONTOLOGY_ID="-100xxxxxxxxxx"  # 🦖 Paleontology & Prehistoric Life
TG_CHANNEL_ROCKETS_ID="-100xxxxxxxxxx"       # 🚀 Rocket Science & Space Missions

# ------------------------------------------------------------------------------
# 7. SUPABASE CONFIGURATION (Persistent Reels Database)
# ------------------------------------------------------------------------------
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your_supabase_service_role_or_anon_key"

# ------------------------------------------------------------------------------
# 8. SERVER & FACEBOOK WEBHOOK CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
FB_VERIFY_TOKEN="your_facebook_webhook_secret_token"
